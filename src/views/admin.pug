html
    head
        meta(charset="utf-8")
        link(rel="stylesheet", href="/css/site.css")
        script(src="/js/site.js", defer)
        title Drugi Projekt
    body
        main(class="main")

            h2 Admin panel

            h1 Komentari 
            div(id="comments", class="comments")

            if user
                form(method="post", action="/comment/delete-all")
                    button(type="submit") Obriši sve komentare

            form(method="post", action="/comment")
                div
                    label(for="comment") Komentar:
                    textarea(id="comment", name="comment", maxlength="2000", required)
                button(type="submit") Objavi komentar
            
            form(method="post", action="/logout")
                button(type="submit") Logout    
