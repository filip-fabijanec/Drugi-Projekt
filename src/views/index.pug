html
    head
        meta(charset="utf-8")
        link(rel="stylesheet", href="/css/site.css")
        script(src="/js/site.js", defer)
        title Drugi Projekt
    body
        main(class="main")
            div(class="upute")
                h2 Upute
                p Ovaj forum je namijenjen za testiranje XSS ranjivosti. 
                - var primjer = '<img src="x" onerror="alert(\'Kolačić je\' + document.cookie)">'
                p Upišite komentar u polje ispod kao što je #{primjer} i kliknite na "Objavi komentar". 
                p Ranjivost se može isključiti ili uključiti pomoću checkboxa "Escapiranje komentara" i "HttpOnly zaštita".
            form(method="post", action="/")
                div
                    label(for="switch") Escapiranje komentara:
                    input(type="checkbox", id="switch", name="switch")
            form(method="post", action="/")
                div
                    label(for="httponly") HttpOnly zaštita:
                    input(type="checkbox", id="httponly", name="httponly", checked=httpOnly)
            div(class="upute")
                h2 Upute
                p Ovaj forum je namijenjen i za testiranje Broken Access Control ranjivosti.
                p Ako ste prijavljeni kao admin možete otići na admin stranicu i tamo obrisati sve komentare klikom na "Obriši sve komentare". Ako niste prijavljeni kao admin, dobit ćete poruku o odbijenom pristupu.
                p Ranjivost se može isključiti ili uključiti pomoću checkboxa "Broken Access Control zaštita".
            form(method="post", action="/")
                div
                    label(for="broken-access") Broken Access Control zaštita:
                    input(type="checkbox", id="broken-access", name="broken-access", checked=protectAdminPage)
            if user
                p
                    a(href="/admin") Admin stranica
            if user
                h2 Dobrodošli #{user.username} na forumu, možete ostaviti komentar ispod.
            else
                h2 Dobrodošli na forumu, prijavite se da biste ostavili komentar
            h1 Komentari 
            div(id="comments", class="comments")

            form(method="post", action="/comment")
                div
                    label(for="comment") Komentar:
                    textarea(id="comment", name="comment", maxlength="2000", required)
                button(type="submit") Objavi komentar
            
            if user
                form(method="post", action="/logout")
                    button(type="submit") Logout    
            else
                form(method="get", action="/login")
                    button(type="submit") Login
